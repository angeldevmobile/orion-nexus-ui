# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:5000

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=orion-nexus
DB_PORT=5432

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# ─────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MAX_TOKENS=8192

# ─────────────────────────────────────────────
# Anthropic (Claude)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Orion Cloud Nexus
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=support@yourdomain.com

# ─────────────────────────────────────────────
# GitHub OAuth
# ─────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ─────────────────────────────────────────────
# Google OAuth (opcional)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─────────────────────────────────────────────
# Lemon Squeezy (pagos)
# ─────────────────────────────────────────────
LS_API_KEY=
LS_STORE_ID=
# Variant IDs — obtén los IDs en Lemon Squeezy > Products > cada variante
LS_VARIANT_PRO=
LS_VARIANT_PRO_ANNUAL=
LS_VARIANT_BUSINESS=
LS_VARIANT_BUSINESS_ANNUAL=
LS_VARIANT_ENTERPRISE=
LS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────
SESSION_SECRET=
SESSION_NAME=orion-nexus-session
SESSION_MAX_AGE=86400000

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=js,ts,jsx,tsx,html,css,json,md,txt,py,java,cpp,c,php

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ─────────────────────────────────────────────
# WebSocket
# ─────────────────────────────────────────────
WS_PORT=5001
WS_ORIGINS=http://localhost:8080
